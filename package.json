{
  "name": "@viptv/tv-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run design:check && tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 0.0.0.0",
    "package:tv": "npm run build && node scripts/package-tv.mjs",
    "design:check": "node scripts/design-sync.mjs check"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "qrcode": "1.5.4",
    "lucide-react": "0.468.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@types/qrcode": "1.5.5",
    "@vitejs/plugin-react": "4.3.4",
    "vite": "6.1.0",
    "vitest": "3.2.4",
    "typescript": "5.7.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/jest-dom": "6.6.3",
    "jsdom": "26.0.0",
    "@playwright/test": "1.63.0"
  }
}
