{
  "name": "@viptv/tv-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run design:check && npm run core:check && npm run typecheck && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 0.0.0.0",
    "package:tv": "npm run build && node scripts/package-tv.mjs",
    "design:check": "node scripts/design-sync.mjs check",
    "core:check": "node scripts/core-sync.mjs check",
    "typecheck": "node scripts/typecheck.mjs"
  },
  "dependencies": {
    "@mediabunny/ac3": "^1.56.2",
    "@mediabunny/dts": "^1.56.2",
    "@mediabunny/prores": "^1.56.2",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-http": "^2.6.0",
    "@tauri-apps/plugin-opener": "2.5.5",
    "hls.js": "1.7.3",
    "lucide-react": "0.468.0",
    "mediabunny": "1.56.2",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/node": "22.10.2",
    "@types/qrcode": "1.5.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "26.0.0",
    "typescript": "5.7.3",
    "vite": "6.1.0",
    "vitest": "3.2.4"
  }
}
