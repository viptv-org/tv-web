{
  "name": "@viptv/tv-web",
  "private": true,
  "license": "GPL-2.0-only",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run design:check && npm run core:check && npm run video:check && npm run typecheck && vite build",
    "test": "vitest run --pool=forks --poolOptions.forks.singleFork && npm run test:native",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config=playwright.remote.config.ts",
    "preview": "vite preview --host 0.0.0.0",
    "package:tv": "npm run build && node scripts/package-tv.mjs",
    "design:check": "node scripts/design-sync.mjs check",
    "core:check": "node scripts/core-sync.mjs check",
    "typecheck": "node scripts/typecheck.mjs",
    "video:check": "node scripts/video-sync.mjs check",
    "perf:tv": "node tests/preview/remote-entry-perf.mjs",
    "test:native": "cd roku && vitest run --config vitest.config.mts"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/onest": "^5.3.1",
    "@mediabunny/ac3": "^1.56.2",
    "@mediabunny/dts": "^1.56.2",
    "@mediabunny/prores": "^1.56.2",
    "@solidjs/router": "0.16.3",
    "@solidtv/renderer": "2.0.7",
    "@solidtv/renderer-canvas": "npm:@solidtv/renderer@1.10.2",
    "@solidtv/solid": "github:vynxc/solid#de6c0454d092c62ec093aff31a2398fd2ad2faab",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-http": "^2.6.0",
    "@tauri-apps/plugin-opener": "2.5.5",
    "hls.js": "1.7.3",
    "mediabunny": "1.56.2",
    "qrcode": "1.5.4",
    "solid-js": "1.9.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.10.2",
    "@types/qrcode": "1.5.5",
    "jsdom": "26.0.0",
    "typescript": "5.7.3",
    "vite": "6.1.0",
    "vite-plugin-solid": "2.11.14",
    "vitest": "3.2.4"
  }
}
