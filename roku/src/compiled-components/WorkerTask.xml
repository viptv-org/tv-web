<?xml version="1.0" encoding="utf-8" ?>
<!--
  Generic background worker for the native host. The Task node runs the
  BrightScript function on a separate SceneGraph thread. TypeScript posts a
  request assocarray and observes `response`.
-->
<component name="WorkerTask" extends="Task">
    <interface>
        <field id="request" type="assocarray" />
        <field id="response" type="assocarray" />
    </interface>
    <script type="text/brightscript" uri="WorkerTask.brs" />
</component>
