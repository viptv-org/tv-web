{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "mediabunny": [
        "./node_modules/mediabunny/dist/mediabunny.d.ts"
      ]
    }
  },
  "include": [
    "src",
    "tests",
    "vite.config.ts",
    "playwright.config.ts"
  ]
}
